    <LUACode>
function onInit()
	super.onInit();
	showCustomBuildPoints();
end

function onValueChanged()
	showCustomBuildPoints();
	window.parentcontrol.window.windowlist.window.CalculateBuildPoints();
end

function showCustomBuildPoints()
	if getStringValue() == 'custom' or getStringValue() == 'firstfree' then
		window.customBuildPoints.setVisible(true);
	else
		window.customBuildPoints.setVisible(false);
	end
end</LUACode>
