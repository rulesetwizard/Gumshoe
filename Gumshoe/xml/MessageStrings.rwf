    <XML>&lt;?xml version="1.0" encoding="iso-8859-1"?&gt;
&lt;root&gt;

	&lt;!-- Abilities --&gt;
	&lt;string name="SpendAbilityPool"&gt;Spends 1 point of &lt;/string&gt;
	&lt;string name="RecoverAbilityPool"&gt;Recovers 1 point of &lt;/string&gt;
	&lt;string name="CantSpendAbilityPool"&gt;Cannot spend more points of &lt;/string&gt;
	&lt;string name="CantUseGeneralAbility"&gt;Not enough pool points to spend of &lt;/string&gt;
	&lt;string name="CantSpendBelowLimit"&gt;Cannot voluntarily reduce below -11 the pool of &lt;/string&gt;
	&lt;string name="CantSpendInvestigative"&gt;%s cannot spend investigative points while %s&lt;/string&gt;
	&lt;string name="UntrainedGeneralAbility"&gt;Cannot use untrained ability &lt;/string&gt;
	&lt;string name="IncorrectAbility"&gt;Ability type does not match&lt;/string&gt;
	&lt;string name="LockedList"&gt;The list is not in edit mode&lt;/string&gt;
	&lt;string name="AbilitiesNotInitialized"&gt;Abilities have not been initialized&lt;/string&gt;
	&lt;string name="AbilityNotFound"&gt;The character has no ability: &lt;/string&gt;
	&lt;string name="ResetPoolsTitle"&gt;Reset Ability Pools&lt;/string&gt;
	&lt;string name="ResetPoolsConfirm"&gt;Are you sure you want to reset all Characters' Ability Pools to their rating value?&lt;/string&gt;

  	&lt;!-- Options --&gt;
	&lt;string name="GumshoeOptionsGroup"&gt;Gumshoe System&lt;/string&gt;
	&lt;string name="ForgivingOptionLabel"&gt;General ability tests type&lt;/string&gt;
	&lt;string name="OptionForgiving"&gt;Forgiving&lt;/string&gt;
	&lt;string name="OptionUnforgiving"&gt;Unforgiving&lt;/string&gt;
	&lt;string name="NPCHealthOptionLabel"&gt;NPC Health loss&lt;/string&gt;
	&lt;string name="OptionPurist"&gt;Purist (as investigators)&lt;/string&gt;
	&lt;string name="OptionPulp"&gt;Pulp (die below 0)&lt;/string&gt;
  
  	&lt;!-- Combat --&gt;
	&lt;string name="AttackTarget"&gt;vs %s&lt;/string&gt;
	&lt;string name="AttackHit"&gt;[HIT]&lt;/string&gt;
	&lt;string name="AttackMiss"&gt;[MISS]&lt;/string&gt;
	&lt;string name="DamageTarget"&gt;to %s&lt;/string&gt;
	&lt;string name="DamageApplied"&gt;Damage to %s: [%d - %d armor = %d]&lt;/string&gt;
	&lt;string name="DamageNoHealth"&gt;Cannot find the Health pool to apply damage to &lt;/string&gt;

	&lt;!-- Health and Stability states --&gt;
	&lt;string name="State_hurt"&gt;Hurt&lt;/string&gt;
	&lt;string name="State_seriouslywounded"&gt;Seriously Wounded&lt;/string&gt;
	&lt;string name="State_dead"&gt;Dead&lt;/string&gt;
	&lt;string name="State_shaken"&gt;Shaken&lt;/string&gt;
	&lt;string name="State_shattered"&gt;Shattered&lt;/string&gt;
	&lt;string name="State_incurable"&gt;Incurably Insane&lt;/string&gt;
	&lt;string name="StateEffect_hurt"&gt;cannot spend investigative points, +1 to the difficulty of all tests and contests&lt;/string&gt;
	&lt;string name="StateEffect_seriouslywounded"&gt;cannot fight, and loses 1 Health every half hour until given First Aid&lt;/string&gt;
	&lt;string name="StateEffect_shaken"&gt;cannot spend investigative points, +1 to the difficulty of general abilities&lt;/string&gt;
	&lt;string name="StateEffect_shattered"&gt;can only flee or attack wildly, may develop a mental illness and loses 1 Stability rating point&lt;/string&gt;
	&lt;string name="StateChanged"&gt;%s is now %s&lt;/string&gt;
	&lt;string name="StatePenalty"&gt;[+1 %s]&lt;/string&gt;
	&lt;string name="ConsciousnessRoll"&gt;%s must make a consciousness roll (difficulty %d)&lt;/string&gt;
	&lt;string name="ConsciousnessRollDesc"&gt;Consciousness roll (difficulty %d)&lt;/string&gt;
	&lt;string name="ConsciousnessSuccess"&gt;[CONSCIOUS]&lt;/string&gt;
	&lt;string name="ConsciousnessFailure"&gt;[UNCONSCIOUS]&lt;/string&gt;

	&lt;!-- Stability test --&gt;
	&lt;string name="StabilityTestRequested"&gt;%s must make a Stability test against %s (difficulty %d, loss %d)&lt;/string&gt;
	&lt;string name="StabilityTestNoPCs"&gt;There are no PCs in the combat tracker to ask for a Stability test&lt;/string&gt;
	&lt;string name="StabilityTestPending"&gt;Stability test: difficulty %d, loss %d (%s)&lt;/string&gt;
	&lt;string name="StabilityTestDifficulty"&gt;(difficulty %d)&lt;/string&gt;
	&lt;string name="StabilityTestSuccess"&gt;[SUCCESS]&lt;/string&gt;
	&lt;string name="StabilityTestFailure"&gt;[FAILURE: -%d Stability]&lt;/string&gt;
  
&lt;/root&gt;      
