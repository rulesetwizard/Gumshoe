<DocumentElement xmlns="http://tempuri.org/Ruleset.xsd">
  <Scripts>
    <ScriptName>GumshoeManager</ScriptName>
    <FolderID>0</FolderID>
    <Script>
OOB_MSGTYPE_APPLYDMG = "gumshoe_applydmg";

-- Health and Stability can be spent below 0, but not voluntarily below this value
local MinVoluntaryPool = -11;

function onInit()
	OOBManager.registerOOBMsgHandler(OOB_MSGTYPE_APPLYDMG, handleApplyDamage);
end

function UseAbilityPool(rAbility, PCnode, bRecover)

	local abilityName = DB.getChild(rAbility, "name");
	local abilityPool = DB.getChild(rAbility, "pool");
	local abilityPoolValue = abilityPool.getValue();
	
	local message = '';
	if bRecover then
		local abilityRating = DB.getChild(rAbility, "rating");
		local abilityRatingValue = abilityRating.getValue();
		if abilityPoolValue &lt; abilityRatingValue then
			message = Interface.getString("RecoverAbilityPool") ..  abilityName.getValue();
			abilityPool.setValue(abilityPoolValue + 1);
			ChatManager.Message(message, true, PCnode);
		end
		return true;
	else
		if  abilityPoolValue &gt; 0 then
			message = Interface.getString("SpendAbilityPool") ..  abilityName.getValue();
			abilityPool.setValue(abilityPoolValue - 1);
			ChatManager.Message(message, true, PCnode);
			return true;
		else
			message = Interface.getString("CantSpendAbilityPool") ..  abilityName.getValue();
			ChatManager.Message(message, true, PCnode);
			return false;
		end
	end
end

function UseGeneralAbility(rAbility, testValue)

	local PCnode = rAbility.getChild('....');
	
	local abilityName = DB.getChild(rAbility, "name").getValue();
	local abilityPool = DB.getChild(rAbility, "pool");
	local abilityPoolValue = abilityPool.getValue();
	local abilityRatingValue = DB.getChild(rAbility, "rating").getValue()
	
	local message = '';
	
	if abilityRatingValue == 0 then
		if OptionsManager.isOption("FORGIVING", "no") then
			message = Interface.getString("UntrainedGeneralAbility") ..  abilityName;
			ChatManager.Message(message, true, PCnode);
			return false;
		end
	end
	
	local abilityRole = getAbilityRole(rAbility);
	local bAllowNegativePool = (abilityRole == "health") or (abilityRole == "stability");
	
	if bAllowNegativePool then
		if abilityPoolValue - testValue &lt; MinVoluntaryPool then
			message = Interface.getString("CantSpendBelowLimit") ..  abilityName;
			ChatManager.Message(message, true, PCnode);
			return false;
		end
	elseif testValue &gt; abilityPoolValue then
		message = Interface.getString("CantUseGeneralAbility") ..  abilityName;
		ChatManager.Message(message, true, PCnode);
		return false;
	end

	abilityPool.setValue(abilityPoolValue - testValue);
	return true;
end

function UseNPCAbility(abilityName, poolNode, testValue, bAllowNegativePool)

	local abilityPoolValue = DB.getValue(poolNode, 0);
	
	if testValue &gt; abilityPoolValue and not bAllowNegativePool then
		ChatManager.SystemMessage(Interface.getString("CantUseGeneralAbility") .. abilityName);
		return false;
	end
	
	DB.setValue(poolNode, "number", abilityPoolValue - testValue);
	return true;
end

function getBuildPointsCost(w)
	local nodeWin = w.getDatabaseNode();
	local buildPointsType = DB.getValue(nodeWin, 'buildPointsType', '');
	local rating = DB.getValue(nodeWin, 'rating', 0);
	local customPoints = DB.getValue(nodeWin, 'customBuildPoints', 0);
	
	if buildPointsType == '' or buildPointsType == 'normal' then
		return rating;
	end

	if buildPointsType == 'half' then
		return math.ceil(rating / 2);
	end

	if buildPointsType == 'exotic' then
		if rating &lt;= 0 then
			return 0;
		else
			return 5 + (rating-1);
		end
	end

	if buildPointsType == 'firstfree' then
		if rating &gt; customPoints then
			return rating - customPoints;
		else
			return 0;
		end
	end

	if buildPointsType == 'custom' then
		return customPoints;
	end
	
	--Free
	return 0;
end

function getGeneralAbilityNode(NodeAbilities, abilityName)
	for _,ability in pairs(DB.getChildren(NodeAbilities)) do
		if DB.getValue(ability, "name", "") == abilityName then
			return ability;
		end
	end
	
	return nil;
end

--
-- ABILITY ROLES
-- The code finds Health, Stability and the combat abilities by their role ("health", "stability", "combat" or ""),
-- so that they can have any name
--

function getAbilityRole(nodeAbility)
	local sRole = DB.getValue(nodeAbility, "role");
	if sRole then
		return sRole;
	end
	-- Abilities created before roles existed have no role node: the role comes from the default name
	return GumshoeData.getLegacyRole(DB.getValue(nodeAbility, "name", ""));
end

-- Stores the role of the abilities created before roles existed, when this user can write them
function migrateAbilityRoles(nodeAbilities)
	for _,nodeAbility in pairs(DB.getChildren(nodeAbilities)) do
		if not DB.getChild(nodeAbility, "role") and (Session.IsHost or DB.isOwner(nodeAbility)) then
			DB.setValue(nodeAbility, "role", "string", getAbilityRole(nodeAbility));
		end
	end
end

-- The character's general ability with that role (Health and Stability are unique)
function getAbilityByRole(nodeChar, sRole)
	for _,nodeAbility in pairs(DB.getChildren(nodeChar, "abilities.generalsections")) do
		if getAbilityRole(nodeAbility) == sRole then
			return nodeAbility;
		end
	end
	return nil;
end

-- All the character's general abilities with that role (there can be several combat abilities)
function getAbilitiesByRole(nodeChar, sRole)
	local aAbilities = {};
	for _,nodeAbility in pairs(DB.getChildren(nodeChar, "abilities.generalsections")) do
		if getAbilityRole(nodeAbility) == sRole then
			table.insert(aAbilities, nodeAbility);
		end
	end
	return aAbilities;
end

-- Health pool of an actor: the Health ability of a PC's sheet, or the healthPool of an NPC's CT entry
function getHealthPoolNode(rActor)
	local nodeActor = ActorManager.getCreatureNode(rActor);
	if not nodeActor then
		return nil;
	end

	if ActorManager.isPC(rActor) then
		local nodeHealth = getAbilityByRole(nodeActor, "health");
		if not nodeHealth then
			return nil;
		end
		return DB.createChild(nodeHealth, "pool", "number");
	end

	return DB.createChild(nodeActor, "healthPool", "number");
end

function onAttackResult(rSource, rTarget, rRoll)

    local rMessage = ActionsManager.createActionMessage(rSource, rRoll);
    if rTarget ~= nil then
        rMessage.text = rMessage.text .. " " .. string.format(Interface.getString("AttackTarget"), ActorManager.getDisplayName(rTarget));
		local hitthreshold = DB.getChild(rTarget.sCreatureNode, "hitthreshold").getValue();
		if rRoll.nTotal &gt;= hitthreshold then
			rMessage.text = rMessage.text .. " " .. Interface.getString("AttackHit");
			rMessage.icon = "roll_attack_hit";
		else
			rMessage.text = rMessage.text .. " " .. Interface.getString("AttackMiss");
			rMessage.icon = "roll_attack_miss";
		end
	else
			rMessage.icon = "roll_attack";
    end
	
    Comm.deliverChatMessage(rMessage);
	
end

function onDamageResult(rSource, rTarget, rRoll)
	local rMessage = ActionsManager.createActionMessage(rSource, rRoll);
	if rTarget ~= nil then
		rMessage.text = rMessage.text .. " " .. string.format(Interface.getString("DamageTarget"), ActorManager.getDisplayName(rTarget));
	end
	rMessage.icon = "roll_damage";
	Comm.deliverChatMessage(rMessage);

	if rTarget ~= nil then
		notifyApplyDamage(rTarget, rRoll.nTotal);
	end
end

-- The roller may not own the target's nodes, so the host applies the damage
function notifyApplyDamage(rTarget, nTotal)
	local msgOOB = {};
	msgOOB.type = OOB_MSGTYPE_APPLYDMG;
	msgOOB.sTargetNode = ActorManager.getCreatureNodeName(rTarget);
	msgOOB.nTotal = nTotal;

	Comm.deliverOOBMessage(msgOOB, "");
end

function handleApplyDamage(msgOOB)
	if not Session.IsHost then
		return;
	end

	local rTarget = ActorManager.resolveActor(msgOOB.sTargetNode);
	applyDamage(rTarget, tonumber(msgOOB.nTotal) or 0);
end

function applyDamage(rTarget, nTotal)
	local nodeTarget = ActorManager.getCreatureNode(rTarget);
	local nodeHealthPool = getHealthPoolNode(rTarget);
	if not nodeTarget or not nodeHealthPool then
		ChatManager.SystemMessage(Interface.getString("DamageNoHealth") .. ActorManager.getDisplayName(rTarget));
		return;
	end

	local nArmor = DB.getValue(nodeTarget, "armor", 0);
	local nDamage = math.max(nTotal - nArmor, 0);
	if nDamage &gt; 0 then
		DB.setValue(nodeHealthPool, "number", DB.getValue(nodeHealthPool, 0) - nDamage);
	end

	local rMessage = { font = "msgfont", icon = "roll_damage" };
	rMessage.text = string.format(Interface.getString("DamageApplied"), ActorManager.getDisplayName(rTarget), nTotal, nArmor, nDamage);
	Comm.deliverChatMessage(rMessage);
end</Script>
    <RegisterScript>true</RegisterScript>
    <Encoding />
  </Scripts>
</DocumentElement>