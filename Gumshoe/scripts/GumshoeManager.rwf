<DocumentElement xmlns="http://tempuri.org/Ruleset.xsd">
  <Scripts>
    <ScriptName>GumshoeManager</ScriptName>
    <FolderID>0</FolderID>
    <Script>
OOB_MSGTYPE_APPLYDMG = "gumshoe_applydmg";

-- Health and Stability can be spent below 0, but not voluntarily below this value
local MinVoluntaryPool = -11;

function onInit()
	OOBManager.registerOOBMsgHandler(OOB_MSGTYPE_APPLYDMG, handleApplyDamage);
	ActionsManager.registerResultHandler("consciousness", onConsciousnessResult);

	-- Health status of the actors for CoreRPG: token health bars and dots, their colors and the death markers
	GameManager.setFunction("onActorGetHealthStatus", onActorGetHealthStatus);
	ActorHealthManager.registerStatusHealthColor(Interface.getString("State_hurt"), ColorManager.getUIColor("health_simple_bloodied"));
	ActorHealthManager.registerStatusHealthColor(Interface.getString("State_seriouslywounded"), ColorManager.getUIColor("health_unconscious"));
	TokenManager.addDefaultHealthFeatures(nil, { "healthPool", "healthRating" });

	-- The GM sets the difficulty of the general tests, which every roller reads, and keeps the PCs' hit thresholds
	if Session.IsHost then
		initTestDifficulty();
		initHitThresholds();
	end
end

function UseAbilityPool(rAbility, PCnode, bRecover)

	local abilityName = DB.getChild(rAbility, "name");
	local abilityPool = DB.getChild(rAbility, "pool");
	local abilityPoolValue = abilityPool.getValue();
	
	local message = '';
	if bRecover then
		local abilityRating = DB.getChild(rAbility, "rating");
		local abilityRatingValue = abilityRating.getValue();
		if abilityPoolValue &lt; abilityRatingValue then
			message = Interface.getString("RecoverAbilityPool") ..  abilityName.getValue();
			abilityPool.setValue(abilityPoolValue + 1);
			ChatManager.Message(message, true, PCnode);
		end
		return true;
	else
		-- Sanity is never spent: it is only lost
		if getAbilityRole(rAbility) == "sanity" then
			ChatManager.Message(Interface.getString("SanityCannotBeSpent") .. abilityName.getValue(), true, PCnode);
			return false;
		end
		-- Hurt, Shaken and worse characters cannot spend investigative points
		if isInvestigativeAbility(rAbility) then
			local sState = getImpairingState(ActorManager.resolveActor(PCnode));
			if sState ~= "" then
				message = string.format(Interface.getString("CantSpendInvestigative"), DB.getValue(PCnode, "name", ""), sState);
				ChatManager.Message(message, true, PCnode);
				return false;
			end
		end
		if  abilityPoolValue &gt; 0 then
			message = Interface.getString("SpendAbilityPool") ..  abilityName.getValue();
			abilityPool.setValue(abilityPoolValue - 1);
			ChatManager.Message(message, true, PCnode);
			announceStateChange(DB.getValue(PCnode, "name", ""), getAbilityRole(rAbility), abilityPoolValue, abilityPoolValue - 1, false, false);
			return true;
		else
			message = Interface.getString("CantSpendAbilityPool") ..  abilityName.getValue();
			ChatManager.Message(message, true, PCnode);
			return false;
		end
	end
end

function isInvestigativeAbility(nodeAbility)
	return (DB.getPath(nodeAbility):find(".investigativesections.", 1, true) ~= nil);
end

function UseGeneralAbility(rAbility, testValue)

	local PCnode = rAbility.getChild('....');
	
	local abilityName = DB.getChild(rAbility, "name").getValue();
	local abilityPool = DB.getChild(rAbility, "pool");
	local abilityPoolValue = abilityPool.getValue();
	local abilityRatingValue = DB.getChild(rAbility, "rating").getValue()
	
	local message = '';
	
	local abilityRole = getAbilityRole(rAbility);
	-- Sanity is never spent or tested: it is only lost
	if abilityRole == "sanity" then
		ChatManager.Message(Interface.getString("SanityCannotBeSpent") .. abilityName, true, PCnode);
		return false;
	end

	if abilityRatingValue == 0 then
		if OptionsManager.isOption("FORGIVING", "no") then
			message = Interface.getString("UntrainedGeneralAbility") ..  abilityName;
			ChatManager.Message(message, true, PCnode);
			return false;
		end
	end
	
	local bAllowNegativePool = (abilityRole == "health") or (abilityRole == "stability");
	
	if bAllowNegativePool then
		if abilityPoolValue - testValue &lt; MinVoluntaryPool then
			message = Interface.getString("CantSpendBelowLimit") ..  abilityName;
			ChatManager.Message(message, true, PCnode);
			return false;
		end
	elseif testValue &gt; abilityPoolValue then
		message = Interface.getString("CantUseGeneralAbility") ..  abilityName;
		ChatManager.Message(message, true, PCnode);
		return false;
	end

	abilityPool.setValue(abilityPoolValue - testValue);
	announceStateChange(DB.getValue(PCnode, "name", ""), abilityRole, abilityPoolValue, abilityPoolValue - testValue, false, false);
	return true;
end

-- poolNode is the pool field itself: DB.getValue and DB.setValue take the default value and the type right after a
-- path, not after a node, so they get its path
function UseNPCAbility(abilityName, poolNode, testValue, bAllowNegativePool)

	local sPoolPath = DB.getPath(poolNode);
	local abilityPoolValue = DB.getValue(sPoolPath, 0);
	
	if testValue &gt; abilityPoolValue and not bAllowNegativePool then
		ChatManager.SystemMessage(Interface.getString("CantUseGeneralAbility") .. abilityName);
		return false;
	end
	
	DB.setValue(sPoolPath, "number", abilityPoolValue - testValue);
	return true;
end

function getBuildPointsCost(w)
	local nodeWin = w.getDatabaseNode();
	local buildPointsType = DB.getValue(nodeWin, 'buildPointsType', '');
	local rating = DB.getValue(nodeWin, 'rating', 0);
	local customPoints = DB.getValue(nodeWin, 'customBuildPoints', 0);
	
	if buildPointsType == '' or buildPointsType == 'normal' then
		return rating;
	end

	if buildPointsType == 'half' then
		return math.ceil(rating / 2);
	end

	if buildPointsType == 'exotic' then
		if rating &lt;= 0 then
			return 0;
		else
			return 5 + (rating-1);
		end
	end

	if buildPointsType == 'firstfree' then
		if rating &gt; customPoints then
			return rating - customPoints;
		else
			return 0;
		end
	end

	if buildPointsType == 'custom' then
		return customPoints;
	end
	
	--Free
	return 0;
end

function getGeneralAbilityNode(NodeAbilities, abilityName)
	for _,ability in pairs(DB.getChildren(NodeAbilities)) do
		if DB.getValue(ability, "name", "") == abilityName then
			return ability;
		end
	end
	
	return nil;
end

--
-- ABILITY ROLES
-- The code finds Health, Stability, Sanity, the combat abilities, Athletics, Sense Trouble, the stealth abilities and
-- Cthulhu Mythos by their role ("health", "stability", "sanity", "combat", "athletics", "sensetrouble", "stealth",
-- "mythos" or ""), so that they can have any name
--

-- Roles that only one general ability of a character can have
local UniqueRoles = { health = true, stability = true, sanity = true, athletics = true, sensetrouble = true };

-- Roles added after the first ones. Abilities that had no role then get them from their default name, once
local RolesVersion = 2;
local RolesAddedInVersion2 = { athletics = true, sensetrouble = true, stealth = true };

function getAbilityRole(nodeAbility)
	local sRole = DB.getValue(nodeAbility, "role");
	if sRole then
		return sRole;
	end
	-- Abilities created before roles existed have no role node: the role comes from the default name
	return GumshoeData.getLegacyRole(DB.getValue(nodeAbility, "name", ""));
end

-- The unique roles: when an ability gets one of them, the other abilities of the list that have it lose it. The role
-- selector calls it after storing its own value
function clearRoleElsewhere(nodeAbility, sRole)
	if not UniqueRoles[sRole] then
		return;
	end
	local sPath = DB.getPath(nodeAbility);
	for _,nodeOther in pairs(DB.getChildren(DB.getParent(nodeAbility))) do
		if DB.getPath(nodeOther) ~= sPath and getAbilityRole(nodeOther) == sRole then
			DB.setValue(nodeOther, "role", "string", "");
		end
	end
end

-- Sets the role of a general ability, keeping the unique roles unique
function setAbilityRole(nodeAbility, sRole)
	clearRoleElsewhere(nodeAbility, sRole);
	DB.setValue(nodeAbility, "role", "string", sRole);
end

-- Stores the role of the abilities created before roles existed, and gives the roles added later to the abilities
-- without role that have their default name, when this user can write them
function migrateAbilityRoles(nodeAbilities)
	if not nodeAbilities then
		return;
	end
	local nodeChar = DB.getChild(nodeAbilities, "...");
	local bUpgrade = nodeChar and DB.getValue(nodeChar, "rolesversion", 1) &lt; RolesVersion and (Session.IsHost or DB.isOwner(nodeChar));
	for _,nodeAbility in pairs(DB.getChildren(nodeAbilities)) do
		if Session.IsHost or DB.isOwner(nodeAbility) then
			if not DB.getChild(nodeAbility, "role") then
				DB.setValue(nodeAbility, "role", "string", getAbilityRole(nodeAbility));
			elseif bUpgrade and DB.getValue(nodeAbility, "role", "") == "" then
				local sRole = GumshoeData.getLegacyRole(DB.getValue(nodeAbility, "name", ""));
				if RolesAddedInVersion2[sRole] then
					setAbilityRole(nodeAbility, sRole);
				end
			end
		end
	end
	if bUpgrade then
		DB.setValue(nodeChar, "rolesversion", "number", RolesVersion);
	end
end

-- The character's general ability with that role (Health, Stability and Sanity are unique)
function getAbilityByRole(nodeChar, sRole)
	for _,nodeAbility in pairs(DB.getChildren(nodeChar, "abilities.generalsections")) do
		if getAbilityRole(nodeAbility) == sRole then
			return nodeAbility;
		end
	end
	return nil;
end

-- All the character's general abilities with that role (there can be several combat abilities)
function getAbilitiesByRole(nodeChar, sRole)
	local aAbilities = {};
	for _,nodeAbility in pairs(DB.getChildren(nodeChar, "abilities.generalsections")) do
		if getAbilityRole(nodeAbility) == sRole then
			table.insert(aAbilities, nodeAbility);
		end
	end
	return aAbilities;
end

-- The character's investigative ability with that role, in any section (Cthulhu Mythos)
function getInvestigativeAbilityByRole(nodeChar, sRole)
	for _,nodeSection in pairs(DB.getChildren(nodeChar, "abilities.investigativesections")) do
		for _,nodeAbility in pairs(DB.getChildren(nodeSection, "abilities")) do
			if getAbilityRole(nodeAbility) == sRole then
				return nodeAbility;
			end
		end
	end
	return nil;
end

--
-- HEALTH, STABILITY AND SANITY STATES (Trail of Cthulhu)
-- Health: Hurt from 0 to -5, Seriously Wounded from -6 to -11, Dead at -12. Stability: Shaken from 0 to -5,
-- Shattered from -6 to -11, Incurably Insane at -12. Sanity: lost to the Mythos at 0
--

-- States with an effect that is told in the chat
local StatesWithEffect = { hurt = true, seriouslywounded = true, shaken = true, shattered = true, lost = true };

-- bPulpNPC: with the pulp option, NPCs die when their Health drops below 0
function getHealthState(nPool, bPulpNPC)
	if nPool &gt; 0 then
		return "";
	end
	if bPulpNPC and nPool &lt; 0 then
		return "dead";
	end
	if nPool &gt;= -5 then
		return "hurt";
	end
	if nPool &gt;= -11 then
		return "seriouslywounded";
	end
	return "dead";
end

function getStabilityState(nPool)
	if nPool &gt; 0 then
		return "";
	end
	if nPool &gt;= -5 then
		return "shaken";
	end
	if nPool &gt;= -11 then
		return "shattered";
	end
	return "incurable";
end

function getSanityState(nPool)
	if nPool &gt; 0 then
		return "";
	end
	return "lost";
end

-- State of a Health, Stability or Sanity pool, by the role of the ability ("" for any other role)
function getPoolState(sRole, nPool, bPulpNPC)
	if sRole == "health" then
		return getHealthState(nPool, bPulpNPC);
	end
	if sRole == "stability" then
		return getStabilityState(nPool);
	end
	if sRole == "sanity" then
		return getSanityState(nPool);
	end
	return "";
end

function getStateText(sState)
	if (sState or "") == "" then
		return "";
	end
	return Interface.getString("State_" .. sState);
end

function isPulpNPC(rActor)
	return not ActorManager.isPC(rActor) and OptionsManager.isOption("NPCHEALTH", "pulp");
end

-- Health pool and rating of an actor, without creating nodes: the Health ability of a PC, or the NPC's fields
function getActorHealth(rActor)
	local nodeActor = ActorManager.getCreatureNode(rActor);
	if not nodeActor then
		return nil;
	end
	if ActorManager.isPC(rActor) then
		local nodeHealth = getAbilityByRole(nodeActor, "health");
		if not nodeHealth then
			return nil;
		end
		return DB.getValue(nodeHealth, "pool", 0), DB.getValue(nodeHealth, "rating", 0);
	end
	return DB.getValue(nodeActor, "healthPool", 0), DB.getValue(nodeActor, "healthRating", 0);
end

-- Stability pool of a PC (NPCs have no Stability)
function getActorStability(rActor)
	if not ActorManager.isPC(rActor) then
		return nil;
	end
	local nodeStability = getAbilityByRole(ActorManager.getCreatureNode(rActor), "stability");
	if not nodeStability then
		return nil;
	end
	return DB.getValue(nodeStability, "pool", 0);
end

-- Sanity pool of a PC that has Sanity
function getActorSanity(rActor)
	if not ActorManager.isPC(rActor) then
		return nil;
	end
	local nodeSanity = getAbilityByRole(ActorManager.getCreatureNode(rActor), "sanity");
	if not nodeSanity then
		return nil;
	end
	return DB.getValue(nodeSanity, "pool", 0);
end

-- Text of the Health, Stability and Sanity states of an actor, for the sheet and the combat tracker
function getActorStatesText(rActor)
	local aStates = {};
	local nHealth = getActorHealth(rActor);
	if nHealth then
		local sState = getStateText(getHealthState(nHealth, isPulpNPC(rActor)));
		if sState ~= "" then
			table.insert(aStates, sState);
		end
	end
	local nStability = getActorStability(rActor);
	if nStability then
		local sState = getStateText(getStabilityState(nStability));
		if sState ~= "" then
			table.insert(aStates, sState);
		end
	end
	local nSanity = getActorSanity(rActor);
	if nSanity then
		local sState = getStateText(getSanityState(nSanity));
		if sState ~= "" then
			table.insert(aStates, sState);
		end
	end
	return table.concat(aStates, ", ");
end

-- The first state of an actor that stops it spending investigative points and adds 1 to its difficulties (Hurt or
-- Shaken, and worse), as text; "" if it has none. The penalty does not add up with both states
function getImpairingState(rActor)
	if not rActor then
		return "";
	end
	local nHealth = getActorHealth(rActor);
	if nHealth then
		local sState = getHealthState(nHealth, isPulpNPC(rActor));
		if sState ~= "" then
			return getStateText(sState);
		end
	end
	local nStability = getActorStability(rActor);
	if nStability then
		local sState = getStabilityState(nStability);
		if sState ~= "" then
			return getStateText(sState);
		end
	end
	return "";
end

-- For CoreRPG (GameManager onActorGetHealthStatus): wounded from the full pool (0) to -12 (1)
function onActorGetHealthStatus(rActor)
	local nPool, nRating = getActorHealth(rActor);
	if not nPool then
		return 0, ActorHealthManager.STATUS_HEALTHY;
	end

	local sState = getHealthState(nPool, isPulpNPC(rActor));
	if sState == "dead" then
		return 1, ActorHealthManager.STATUS_DEAD;
	end

	local nPercentWounded = math.max(0, math.min(1, (nRating - nPool) / (nRating + 12)));
	if sState == "" then
		return nPercentWounded, ActorHealthManager.getDefaultStatusFromWoundPercent(nPercentWounded);
	end
	return nPercentWounded, getStateText(sState);
end

-- Tells the table when a Health, Stability or Sanity pool enters a new state, with its effects, and asks for the
-- consciousness roll when damage leaves Health below 0
function announceStateChange(sName, sRole, nOldPool, nNewPool, bPulpNPC, bCheckConsciousness)
	local sOldState = getPoolState(sRole, nOldPool, bPulpNPC);
	local sNewState = getPoolState(sRole, nNewPool, bPulpNPC);
	if sNewState ~= sOldState and sNewState ~= "" then
		local sText = string.format(Interface.getString("StateChanged"), sName, getStateText(sNewState));
		if StatesWithEffect[sNewState] then
			sText = sText .. ": " .. Interface.getString("StateEffect_" .. sNewState);
		end
		Comm.deliverChatMessage({ font = "msgfont", icon = "roll_damage", text = sText });
	end

	if bCheckConsciousness and sRole == "health" and nNewPool &lt; 0 and nNewPool &lt; nOldPool and sNewState ~= "dead" then
		Comm.deliverChatMessage({ font = "msgfont", text = string.format(Interface.getString("ConsciousnessRoll"), sName, math.abs(nNewPool)) });
	end
end

--
-- GENERAL ABILITY TESTS
-- A die plus the points spent against the difficulty the GM sets in the GM panel, 4 by default. Hurt or Shaken (and
-- worse) add 1 to it. Against a targeted creature, its Alertness modifier is added to the stealth tests and its
-- Stealth modifier to the Sense Trouble tests. When the GM hides the difficulty, the players only see the result
--

local DifficultyPath = "gumshoe.difficulty";
local DifficultyHiddenPath = "gumshoe.difficultyhidden";
local DefaultDifficulty = 4;

-- In the host: the difficulty starts at its default value, and the players' rolls can read it
function initTestDifficulty()
	if not DB.findNode(DifficultyPath) then
		DB.setValue(DifficultyPath, "number", DefaultDifficulty);
	end
	DB.setPublic(DB.findNode("gumshoe"), true);
end

function getTestDifficulty()
	return DB.getValue(DifficultyPath, DefaultDifficulty);
end

function setTestDifficulty(nDifficulty)
	DB.setValue(DifficultyPath, "number", math.max(nDifficulty, 0));
end

function isTestDifficultyHidden()
	return (DB.getValue(DifficultyHiddenPath, 0) == 1);
end

function setTestDifficultyHidden(bHidden)
	local nHidden = 0;
	if bHidden then
		nHidden = 1;
	end
	DB.setValue(DifficultyHiddenPath, "number", nHidden);
end

-- Data that a general test carries to its result handler (the rRoll fields sRole and sPenalty), taken before the test
-- spends its points, so that spending Health or Stability on it does not make it harder: the role of the ability and
-- the state that adds 1 to the difficulty
function getGeneralTestInfo(nodeActor, sRole)
	return { sRole = sRole or "", sPenalty = getImpairingState(ActorManager.resolveActor(nodeActor)) };
end

-- Modifier of a targeted creature to the difficulty of a test, with the string of its text: its Alertness against the
-- stealth abilities and its Stealth against Sense Trouble. PCs have neither
function getTargetTestModifier(rTarget, sRole)
	if ActorManager.isPC(rTarget) then
		return 0, nil;
	end
	local nodeTarget = ActorManager.getCreatureNode(rTarget);
	if not nodeTarget then
		return 0, nil;
	end
	if sRole == "stealth" then
		return DB.getValue(nodeTarget, "alertness", 0), "AlertnessModifier";
	end
	if sRole == "sensetrouble" then
		return DB.getValue(nodeTarget, "stealth", 0), "StealthModifier";
	end
	return 0, nil;
end

function onGeneralTestResult(rSource, rTarget, rRoll)
	local rMessage = ActionsManager.createActionMessage(rSource, rRoll);
	local nTotal = ActionsManager.total(rRoll);
	local nDifficulty = getTestDifficulty();
	local aModifiers = {};

	local sPenalty = rRoll.sPenalty or "";
	if sPenalty ~= "" then
		nDifficulty = nDifficulty + 1;
		table.insert(aModifiers, string.format(Interface.getString("StatePenalty"), sPenalty));
	end

	if rTarget then
		rMessage.text = rMessage.text .. " " .. string.format(Interface.getString("TestTarget"), ActorManager.getDisplayName(rTarget));
		local nModifier, sModifier = getTargetTestModifier(rTarget, rRoll.sRole or "");
		if nModifier ~= 0 then
			nDifficulty = nDifficulty + nModifier;
			table.insert(aModifiers, string.format(Interface.getString(sModifier), nModifier));
		end
	end
	table.insert(aModifiers, string.format(Interface.getString("TestDifficulty"), nDifficulty));
	local sDetails = table.concat(aModifiers, " ");

	local sResult = Interface.getString("TestFailure");
	if nTotal &gt;= nDifficulty then
		sResult = Interface.getString("TestSuccess");
	end

	if isTestDifficultyHidden() then
		local rMessageGM = UtilityManager.copyDeep(rMessage);
		rMessageGM.text = rMessageGM.text .. " " .. sDetails .. " " .. sResult;
		rMessageGM.secret = true;
		Comm.deliverChatMessage(rMessageGM, "");
		rMessage.text = rMessage.text .. " " .. sResult;
	else
		rMessage.text = rMessage.text .. " " .. sDetails .. " " .. sResult;
	end
	Comm.deliverChatMessage(rMessage);
end

--
-- HIT THRESHOLD
-- 3 for the PCs, 4 with an Athletics rating of 8 or more. The host keeps it in the sheet, where the combat tracker
-- shows it. NPCs have their own
--

local BaseHitThreshold = 3;
local AthleticsHitThreshold = 4;
local AthleticsHitThresholdRating = 8;

function getPCHitThreshold(nodeChar)
	local nodeAthletics = getAbilityByRole(nodeChar, "athletics");
	if nodeAthletics and DB.getValue(nodeAthletics, "rating", 0) &gt;= AthleticsHitThresholdRating then
		return AthleticsHitThreshold;
	end
	return BaseHitThreshold;
end

function getHitThreshold(rActor)
	local nodeActor = ActorManager.getCreatureNode(rActor);
	if not nodeActor then
		return BaseHitThreshold;
	end
	if ActorManager.isPC(rActor) then
		return getPCHitThreshold(nodeActor);
	end
	return DB.getValue(nodeActor, "hitthreshold", BaseHitThreshold);
end

function updateHitThreshold(nodeChar)
	if not nodeChar then
		return;
	end
	local nHitThreshold = getPCHitThreshold(nodeChar);
	if DB.getValue(nodeChar, "hitthreshold", 0) ~= nHitThreshold then
		DB.setValue(nodeChar, "hitthreshold", "number", nHitThreshold);
	end
end

-- The character a node of its sheet belongs to
local function getCharOfNode(node)
	local sChar = DB.getPath(node):match("^(charsheet%.[^%.]+)");
	if not sChar then
		return nil;
	end
	return DB.findNode(sChar);
end

function onGeneralAbilityChanged(nodeField)
	updateHitThreshold(getCharOfNode(nodeField));
end

-- In the host: the sheets get the roles added later before their hit threshold is updated, and it follows the
-- rating and role changes of their general abilities, even with the sheet closed
function initHitThresholds()
	for _,nodeChar in pairs(DB.getChildren("charsheet")) do
		migrateAbilityRoles(DB.getChild(nodeChar, "abilities.generalsections"));
		updateHitThreshold(nodeChar);
	end
	DB.addHandler("charsheet.*.abilities.generalsections.*.rating", "onUpdate", onGeneralAbilityChanged);
	DB.addHandler("charsheet.*.abilities.generalsections.*.role", "onAdd", onGeneralAbilityChanged);
	DB.addHandler("charsheet.*.abilities.generalsections.*.role", "onUpdate", onGeneralAbilityChanged);
	DB.addHandler("charsheet.*.abilities.generalsections", "onChildDeleted", onGeneralAbilityChanged);
end

--
-- SANITY (Trail of Cthulhu)
-- Sanity can never be higher than 10 minus the Cthulhu Mythos rating. It is lost by Mythos shocks and Mythos
-- revelations, never by a roll
--

function getSanityLimit(nodeChar)
	local nodeMythos = getInvestigativeAbilityByRole(nodeChar, "mythos");
	local nMythos = 0;
	if nodeMythos then
		nMythos = DB.getValue(nodeMythos, "rating", 0);
	end
	return math.max(10 - nMythos, 0);
end

-- Lowers the Sanity rating and pool to the limit, when this user can write the sheet
function applySanityLimit(nodeChar)
	if not nodeChar or not (Session.IsHost or DB.isOwner(nodeChar)) then
		return;
	end
	local nodeSanity = getAbilityByRole(nodeChar, "sanity");
	if not nodeSanity then
		return;
	end
	local nLimit = getSanityLimit(nodeChar);
	local bLowered = false;
	if DB.getValue(nodeSanity, "rating", 0) &gt; nLimit then
		DB.setValue(nodeSanity, "rating", "number", nLimit);
		bLowered = true;
	end
	if DB.getValue(nodeSanity, "pool", 0) &gt; nLimit then
		DB.setValue(nodeSanity, "pool", "number", nLimit);
		bLowered = true;
	end
	if bLowered then
		Comm.deliverChatMessage({ font = "msgfont", text = string.format(Interface.getString("SanityLimited"), DB.getValue(nodeChar, "name", ""), nLimit) });
	end
end

-- Lowers a pool of the character by role and tells the state it enters
local function losePool(nodeChar, sRole, nLoss)
	local nodeAbility = getAbilityByRole(nodeChar, sRole);
	if not nodeAbility or nLoss &lt;= 0 then
		return;
	end
	local nOldPool = DB.getValue(nodeAbility, "pool", 0);
	DB.setValue(nodeAbility, "pool", "number", nOldPool - nLoss);
	announceStateChange(DB.getValue(nodeChar, "name", ""), sRole, nOldPool, nOldPool - nLoss, false, false);
end

-- Mythos shock: becoming Shaken after a Mythos creature costs 1 Sanity, Shattered (or worse) 2. Only the most severe
-- of them is suffered in an investigation, so only the difference with the one already suffered is lost. The pool
-- reset at the end of the investigation clears it
function applyMythosShock(nodeChar, sStabilityState)
	if not getAbilityByRole(nodeChar, "sanity") then
		return;
	end
	local nShock = 0;
	if sStabilityState == "shaken" then
		nShock = 1;
	elseif sStabilityState == "shattered" or sStabilityState == "incurable" then
		nShock = 2;
	end
	local nSuffered = DB.getValue(nodeChar, "sanityshock", 0);
	if nShock &lt;= nSuffered then
		return;
	end
	DB.setValue(nodeChar, "sanityshock", "number", nShock);
	Comm.deliverChatMessage({ font = "msgfont", icon = "roll_damage", text = string.format(Interface.getString("MythosShock"), DB.getValue(nodeChar, "name", ""), nShock - nSuffered) });
	losePool(nodeChar, "sanity", nShock - nSuffered);
end

-- Losses of Stability and Sanity of the Mythos revelations, from the least to the most serious
local MythosRevelationLoss = {
	{ nStability = 2, nSanity = 0 },
	{ nStability = 3, nSanity = 1 },
	{ nStability = 4, nSanity = 1 },
	{ nStability = 6, nSanity = 2 },
	{ nStability = 8, nSanity = 3 },
};

function getMythosRevelationCount()
	return #MythosRevelationLoss;
end

-- Using Cthulhu Mythos to piece together a revelation: the loss depends on the revelation, not on the points spent
function applyMythosRevelation(nodeChar, nLevel)
	local rLoss = MythosRevelationLoss[nLevel];
	if not rLoss or not nodeChar or not (Session.IsHost or DB.isOwner(nodeChar)) then
		return;
	end
	Comm.deliverChatMessage({ font = "msgfont", icon = "roll_damage", text = string.format(Interface.getString("MythosRevelationApplied"), DB.getValue(nodeChar, "name", ""), Interface.getString("MythosRevelation" .. nLevel), rLoss.nStability, rLoss.nSanity) });
	losePool(nodeChar, "stability", rLoss.nStability);
	losePool(nodeChar, "sanity", rLoss.nSanity);
end

--
-- CONSCIOUSNESS ROLL
-- A die against the absolute value of the Health pool. The character can reduce Health to add to the die; the
-- difficulty is the pool before that reduction
--

function rollConsciousness(nodeActor, nDifficulty, nBonus)
	local sDice = "d6";
	if (nBonus or 0) &gt; 0 then
		sDice = "d6+" .. nBonus;
	end
	RulesetWizardDiceRoller.Roll(nil, nodeActor, "consciousness", string.format(Interface.getString("ConsciousnessRollDesc"), nDifficulty), sDice, 0, { nDifficulty = nDifficulty });
end

function onConsciousnessResult(rSource, rTarget, rRoll)
	local rMessage = ActionsManager.createActionMessage(rSource, rRoll);
	if rRoll.nTotal &gt;= (tonumber(rRoll.nDifficulty) or 0) then
		rMessage.text = rMessage.text .. " " .. Interface.getString("ConsciousnessSuccess");
	else
		rMessage.text = rMessage.text .. " " .. Interface.getString("ConsciousnessFailure");
	end
	Comm.deliverChatMessage(rMessage);
end

--
-- STABILITY TEST (Trail of Cthulhu)
-- Difficulty 4, +1 against the Mythos. A failed test loses the potential loss of the situation, plus the Stability
-- loss modifier of the creature. The PC rolls from the sheet, with the test the NPC left pending in it
--

-- Potential loss of the situations with a supernatural creature: seen from afar, up close, attacking, or gigantic or
-- a horde attacking
local StabilityEncounterLoss = { [""] = 4, ["close"] = 5, ["attack"] = 6, ["horde"] = 8 };

-- From the NPC sheet, in the host: asks the PCs the NPC targets in the combat tracker, or every PC in it, for a
-- Stability test
function requestStabilityTest(nodeNPC)
	if not Session.IsHost then
		return;
	end
	local rNPC = ActorManager.resolveActor(nodeNPC);
	local nMythos = DB.getValue(nodeNPC, "isMythos", 0);
	local nDifficulty = 4;
	if nMythos == 1 then
		nDifficulty = 5;
	end
	local nLoss = (StabilityEncounterLoss[DB.getValue(nodeNPC, "stabilityEncounter", "")] or 4) + DB.getValue(nodeNPC, "stabilityLoss", 0);
	local sSource = ActorManager.getDisplayName(rNPC);

	local aPCs = {};
	for _,rTarget in ipairs(TargetingManager.getFullTargets(rNPC)) do
		if ActorManager.isPC(rTarget) then
			table.insert(aPCs, rTarget);
		end
	end
	if #aPCs == 0 then
		for _,nodeCT in pairs(CombatManager.getCombatantNodes()) do
			local rActor = ActorManager.resolveActor(nodeCT);
			if ActorManager.isPC(rActor) then
				table.insert(aPCs, rActor);
			end
		end
	end
	if #aPCs == 0 then
		ChatManager.SystemMessage(Interface.getString("StabilityTestNoPCs"));
		return;
	end

	for _,rPC in ipairs(aPCs) do
		local nodeChar = ActorManager.getCreatureNode(rPC);
		if nodeChar then
			DB.setValue(nodeChar, "pendingstability.difficulty", "number", nDifficulty);
			DB.setValue(nodeChar, "pendingstability.loss", "number", nLoss);
			DB.setValue(nodeChar, "pendingstability.source", "string", sSource);
			DB.setValue(nodeChar, "pendingstability.mythos", "number", nMythos);
			DB.setValue(nodeChar, "pendingstability.penalty", "string", "");
			Comm.deliverChatMessage({ font = "msgfont", text = string.format(Interface.getString("StabilityTestRequested"), ActorManager.getDisplayName(rPC), sSource, nDifficulty, nLoss) });
		end
	end
end

-- Text of the pending Stability test of a PC, for the sheet; "" if there is none
function getPendingStabilityText(nodeChar)
	local nodePending = DB.getChild(nodeChar, "pendingstability");
	if not nodePending then
		return "";
	end
	return string.format(Interface.getString("StabilityTestPending"), DB.getValue(nodePending, "difficulty", 4), DB.getValue(nodePending, "loss", 0), DB.getValue(nodePending, "source", ""));
end

-- Before the Stability roll spends its points: keeps the state that adds 1 to the difficulty, so that the spend
-- itself does not cause it
function prepareStabilityTest(nodeChar)
	local nodePending = DB.getChild(nodeChar, "pendingstability");
	if nodePending then
		DB.setValue(nodePending, "penalty", "string", getImpairingState(ActorManager.resolveActor(nodeChar)));
	end
end

-- Result of the Stability roll of the sheet: without a pending test it is shown as it is
function onStabilityTestResult(rSource, rTarget, rRoll)
	local rMessage = ActionsManager.createActionMessage(rSource, rRoll);
	local nodeChar = ActorManager.getCreatureNode(rSource);
	local nodePending = nil;
	if nodeChar then
		nodePending = DB.getChild(nodeChar, "pendingstability");
	end
	if not nodePending then
		Comm.deliverChatMessage(rMessage);
		return;
	end

	local nDifficulty = DB.getValue(nodePending, "difficulty", 4);
	local nLoss = DB.getValue(nodePending, "loss", 0);
	local bMythos = (DB.getValue(nodePending, "mythos", 0) == 1);
	local sPenalty = DB.getValue(nodePending, "penalty", "");
	if sPenalty ~= "" then
		nDifficulty = nDifficulty + 1;
		rMessage.text = rMessage.text .. " " .. string.format(Interface.getString("StatePenalty"), sPenalty);
	end
	-- Sanity 2 or less also adds 1 to the difficulty of Stability tests
	local nSanity = getActorSanity(rSource);
	if nSanity and nSanity &lt;= 2 then
		nDifficulty = nDifficulty + 1;
		rMessage.text = rMessage.text .. " " .. string.format(Interface.getString("LowSanityPenalty"), nSanity);
	end
	rMessage.text = rMessage.text .. " " .. string.format(Interface.getString("StabilityTestDifficulty"), nDifficulty);

	local bFailed = (rRoll.nTotal &lt; nDifficulty);
	if bFailed then
		rMessage.text = rMessage.text .. " " .. string.format(Interface.getString("StabilityTestFailure"), nLoss);
	else
		rMessage.text = rMessage.text .. " " .. Interface.getString("StabilityTestSuccess");
	end
	Comm.deliverChatMessage(rMessage);

	DB.deleteNode(nodePending);

	if bFailed then
		local nodeStability = getAbilityByRole(nodeChar, "stability");
		if nodeStability then
			local nOldPool = DB.getValue(nodeStability, "pool", 0);
			DB.setValue(nodeStability, "pool", "number", nOldPool - nLoss);
			announceStateChange(DB.getValue(nodeChar, "name", ""), "stability", nOldPool, nOldPool - nLoss, false, false);
			if bMythos then
				applyMythosShock(nodeChar, getStabilityState(nOldPool - nLoss));
			end
		end
	end
end

-- Health pool of an actor: the Health ability of a PC's sheet, or the healthPool of an NPC's CT entry
function getHealthPoolNode(rActor)
	local nodeActor = ActorManager.getCreatureNode(rActor);
	if not nodeActor then
		return nil;
	end

	if ActorManager.isPC(rActor) then
		local nodeHealth = getAbilityByRole(nodeActor, "health");
		if not nodeHealth then
			return nil;
		end
		return DB.createChild(nodeHealth, "pool", "number");
	end

	return DB.createChild(nodeActor, "healthPool", "number");
end

function onAttackResult(rSource, rTarget, rRoll)

    local rMessage = ActionsManager.createActionMessage(rSource, rRoll);
    if rTarget ~= nil then
        rMessage.text = rMessage.text .. " " .. string.format(Interface.getString("AttackTarget"), ActorManager.getDisplayName(rTarget));
		local hitthreshold = getHitThreshold(rTarget);
		-- A Hurt or Shaken attacker (and worse) adds 1 to the hit threshold
		local sState = getImpairingState(rSource);
		if sState ~= "" then
			hitthreshold = hitthreshold + 1;
			rMessage.text = rMessage.text .. " " .. string.format(Interface.getString("StatePenalty"), sState);
		end
		if rRoll.nTotal &gt;= hitthreshold then
			rMessage.text = rMessage.text .. " " .. Interface.getString("AttackHit");
			rMessage.icon = "roll_attack_hit";
		else
			rMessage.text = rMessage.text .. " " .. Interface.getString("AttackMiss");
			rMessage.icon = "roll_attack_miss";
		end
	else
			rMessage.icon = "roll_attack";
    end
	
    Comm.deliverChatMessage(rMessage);
	
end

function onDamageResult(rSource, rTarget, rRoll)
	local rMessage = ActionsManager.createActionMessage(rSource, rRoll);
	if rTarget ~= nil then
		rMessage.text = rMessage.text .. " " .. string.format(Interface.getString("DamageTarget"), ActorManager.getDisplayName(rTarget));
	end
	rMessage.icon = "roll_damage";
	Comm.deliverChatMessage(rMessage);

	if rTarget ~= nil then
		notifyApplyDamage(rTarget, rRoll.nTotal);
	end
end

-- The roller may not own the target's nodes, so the host applies the damage
function notifyApplyDamage(rTarget, nTotal)
	local msgOOB = {};
	msgOOB.type = OOB_MSGTYPE_APPLYDMG;
	msgOOB.sTargetNode = ActorManager.getCreatureNodeName(rTarget);
	msgOOB.nTotal = nTotal;

	Comm.deliverOOBMessage(msgOOB, "");
end

function handleApplyDamage(msgOOB)
	if not Session.IsHost then
		return;
	end

	local rTarget = ActorManager.resolveActor(msgOOB.sTargetNode);
	applyDamage(rTarget, tonumber(msgOOB.nTotal) or 0);
end

function applyDamage(rTarget, nTotal)
	local nodeTarget = ActorManager.getCreatureNode(rTarget);
	local nodeHealthPool = getHealthPoolNode(rTarget);
	if not nodeTarget or not nodeHealthPool then
		ChatManager.SystemMessage(Interface.getString("DamageNoHealth") .. ActorManager.getDisplayName(rTarget));
		return;
	end

	-- The pool node is the field itself: DB.getValue and DB.setValue get its path
	local sHealthPoolPath = DB.getPath(nodeHealthPool);
	local nArmor = DB.getValue(nodeTarget, "armor", 0);
	local nDamage = math.max(nTotal - nArmor, 0);
	local nOldPool = DB.getValue(sHealthPoolPath, 0);
	if nDamage &gt; 0 then
		DB.setValue(sHealthPoolPath, "number", nOldPool - nDamage);
	end

	local rMessage = { font = "msgfont", icon = "roll_damage" };
	rMessage.text = string.format(Interface.getString("DamageApplied"), ActorManager.getDisplayName(rTarget), nTotal, nArmor, nDamage);
	Comm.deliverChatMessage(rMessage);

	announceStateChange(ActorManager.getDisplayName(rTarget), "health", nOldPool, nOldPool - nDamage, isPulpNPC(rTarget), true);
end</Script>
