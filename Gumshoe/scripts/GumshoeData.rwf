<DocumentElement xmlns="http://tempuri.org/Ruleset.xsd">
  <Scripts>
    <ScriptName>GumshoeData</ScriptName>
    <FolderID>3</FolderID>
    <Script>-- Sections in the order they are created on a new character sheet
local InvestigativeAbilities = {
	{
		name = "ACADEMIC",
		abilities = {
			"Anthropology",
			"Archaeology",
			"Architecture",
			"Art History",
			"Botany",
			"Comparative Religion",
			"Forensic Accounting",
			"Forensic Psychology",
			"Geology",
			"History",
			"Languages",
			"Law",
			"Linguistics",
			"Military Tactics",
			"Natural History",
			"Occult Studies",
			"Pathology",
			"Research",
			"Textual Analysis",
			"Trivia",
		},
	},
	{
		name = "INTERPERSONAL",
		abilities = {
			"Authority",
			"Bullshit Detector",
			"Bureaucracy",
			"Charm",
			"Cop Talk",
			"Flattery",
			"Flirting",
			"High Society",
			"Impersonate",
			"Inspiration",
			"Interrogation",
			"Intimidation",
			"Negotiation",
			"Oral History",
			"Reassurance",
			"Respect",
			"Streetwise",
			"Taunt",
			"Tradecraft",
		},
	},
	{
		name = "TECHNICAL",
		abilities = {
			"Astronomy",
			"Ballistics",
			"Camping",
			"Chemistry",
			"Craft",
			"Cryptography",
			"Data Retrieval",
			"Document Analysis",
			"Electronic Surveillance",
			"Evidence Collection",
			"Explosive Devices",
			"Fingerprinting",
			"Forensic Anthropology",
			"Forensic Entomology",
			"Forgery",
			"Hacking",
			"Locksmith",
			"Medical Expertise",
			"Notice",
			"Outdoor Survival",
			"Photography",
			"Science",
			"Spying",
			"Traffic Analysis",
		},
	},
}

-- The role tells the code which ability is Health, Stability or a combat ability, whatever its name
local GeneralAbilities = {
	{ name = "Athletics" },
	{ name = "Burglary" },
	{ name = "Business Affairs" },
	{ name = "Conceal" },
	{ name = "Disguise" },
	{ name = "Driving" },
	{ name = "Explosives" },
	{ name = "Filch" },
	{ name = "Fleeing" },
	{ name = "Gambling" },
	{ name = "Health", role = "health" },
	{ name = "Hypnosis" },
	{ name = "Infiltration" },
	{ name = "Mechanics" },
	{ name = "Medic" },
	{ name = "Piloting" },
	{ name = "Preparedness" },
	{ name = "Public Relations" },
	{ name = "Riding" },
	{ name = "Scuffling", role = "combat" },
	{ name = "Sense Trouble" },
	{ name = "Shrink" },
	{ name = "Shooting", role = "combat" },
	{ name = "Stability", role = "stability" },
	{ name = "Surveillance" },
	{ name = "Unobtrusiveness" },
}

-- Trail of Cthulhu abilities, created with the Sanity option: Sanity (general, 4 free points) and Cthulhu Mythos
-- (academic investigative ability)
local SanityAbility = { name = "Sanity", role = "sanity", rating = 4 };
local MythosAbility = { section = "ACADEMIC", name = "Cthulhu Mythos", role = "mythos" };

local CombatAbilities = {
	"Scuffling",
	"Shooting",
}

local HealthAbility = "Health";
local StabilityAbility = "Stability";


function onInit()

	OptionsManager.registerOption2("FORGIVING", true, "GumshoeOptionsGroup", "ForgivingOptionLabel", "option_entry_cycler", 
			{ labels = "OptionUnforgiving", values = "no", baselabel = "OptionForgiving", baseval = "yes", default = "yes" });

	-- Purist: NPCs lose Health as the investigators. Pulp: ordinary people die when their Health drops below 0
	OptionsManager.registerOption2("NPCHEALTH", false, "GumshoeOptionsGroup", "NPCHealthOptionLabel", "option_entry_cycler", 
			{ labels = "OptionPulp", values = "pulp", baselabel = "OptionPurist", baseval = "purist", default = "purist" });

	-- Sanity and Cthulhu Mythos (Trail of Cthulhu): new characters get them and the main tab shows Sanity
	OptionsManager.registerOption2("SANITY", false, "GumshoeOptionsGroup", "SanityOptionLabel", "option_entry_cycler", 
			{ labels = "option_val_off", values = "off", baselabel = "option_val_on", baseval = "on", default = "on" });

end

function getInvestigativeAbilities()
    return InvestigativeAbilities;
end

function getGeneralAbilities()
    return GeneralAbilities;
end

function getCombatAbilities()
    return CombatAbilities;
end

function getHealthAbility()
	return HealthAbility;
end;

function getStabilityAbility()
	return StabilityAbility;
end;

function isSanityEnabled()
	return OptionsManager.isOption("SANITY", "on");
end

function getSanityAbility()
	return SanityAbility;
end

function getMythosAbility()
	return MythosAbility;
end

function isCombatAbility(abilityName)
	local CombatAbilities = getCombatAbilities();
	for _,v in pairs(CombatAbilities) do
		if v == abilityName then
			return true;
		end
	end
	return false;
end

-- Role of an ability created before roles existed, from its default name
function getLegacyRole(abilityName)
	if abilityName == HealthAbility then
		return "health";
	end
	if abilityName == StabilityAbility then
		return "stability";
	end
	if abilityName == SanityAbility.name then
		return "sanity";
	end
	if abilityName == MythosAbility.name then
		return "mythos";
	end
	if isCombatAbility(abilityName) then
		return "combat";
	end
	return "";
end

-- Sanity does not come back with the other pools (in a purist game it never does)
function ResetAbilityPools()
	for _,nodeChar in pairs(DB.getChildren("charsheet")) do
		-- Reset Investigative Abilities
		for _,nodeSection in pairs(DB.getChildren(nodeChar, "abilities.investigativesections")) do
			for _,nodeAbility in pairs(DB.getChildren(nodeSection, "abilities")) do
				DB.setValue(nodeAbility, "pool", "number", DB.getValue(nodeAbility, "rating", 0));
			end
		end
		-- Reset General Abilities
		for _,nodeAbility in pairs(DB.getChildren(nodeChar, "abilities.generalsections")) do
			if GumshoeManager.getAbilityRole(nodeAbility) ~= "sanity" then
				DB.setValue(nodeAbility, "pool", "number", DB.getValue(nodeAbility, "rating", 0));
			end
		end
	end
end

function resolveRefNode(sRecord)
	local nodeSource = DB.findNode(sRecord);
	if not nodeSource then
		local sRecordSansModule = StringManager.split(sRecord, "@")[1];
		nodeSource = DB.findNode(sRecordSansModule .. "@*");
		if not nodeSource then
			ChatManager.SystemMessage(Interface.getString("IncorrectAbility"));
		end
	end
	return nodeSource;
end
</Script>
    <RegisterScript>true</RegisterScript>
    <Encoding />
  </Scripts>
</DocumentElement>