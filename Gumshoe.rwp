    <LUACode>
-- Path of the character's general abilities, whose changes rebuild the options
local sPCAbilitiesPath = nil;

function onInit()
	super.onInit();

	local nodeChar = DB.getChild(window.getDatabaseNode(), "...");
	if nodeChar then
		sPCAbilitiesPath = DB.getPath(nodeChar, "abilities.generalsections");
		DB.addHandler(sPCAbilitiesPath .. ".*.role", "onAdd", onAbilitiesChanged);
		DB.addHandler(sPCAbilitiesPath .. ".*.role", "onUpdate", onAbilitiesChanged);
		DB.addHandler(sPCAbilitiesPath .. ".*.name", "onUpdate", onAbilitiesChanged);
		DB.addHandler(sPCAbilitiesPath, "onChildDeleted", onAbilitiesChanged);
	end

	updateOptions();
end

function onClose()
	if sPCAbilitiesPath then
		DB.removeHandler(sPCAbilitiesPath .. ".*.role", "onAdd", onAbilitiesChanged);
		DB.removeHandler(sPCAbilitiesPath .. ".*.role", "onUpdate", onAbilitiesChanged);
		DB.removeHandler(sPCAbilitiesPath .. ".*.name", "onUpdate", onAbilitiesChanged);
		DB.removeHandler(sPCAbilitiesPath, "onChildDeleted", onAbilitiesChanged);
	end
end

function onAbilitiesChanged()
	updateOptions();
end

-- The options are the character's combat abilities. The stored ability is kept even if it is no longer one of them:
-- the weapon is then unlinked, and linked again if the ability becomes a combat ability. No initial value is given to
-- initialize, since it would replace the stored one
function updateOptions()
	local aNames = {};
	local nodeChar = DB.getChild(window.getDatabaseNode(), "...");
	for _,nodeAbility in ipairs(GumshoeManager.getAbilitiesByRole(nodeChar, "combat")) do
		local sName = DB.getValue(nodeAbility, "name", "");
		if sName ~= "" then
			table.insert(aNames, sName);
		end
	end
	table.sort(aNames);
	local sValues = table.concat(aNames, "|");
	initialize(sValues, sValues, "", nil);
	setLink(false);
end

function onValueChanged()
	setLink(true);
end

-- Links rating and pool to the character's ability. If it is missing, they are unlinked; when the user chose it,
-- the character is told and the choice cleared (not when the sheet opens, so the stored value is kept)
function setLink(bNotify)
	if getStringValue() == "" then
		unlink();
		return;
	end

	local nodeWin = window.getDatabaseNode();
	local abilitiesNode = DB.getChild(nodeWin, '...abilities.generalsections');
	local abilityNode = nil;
	local message = '';
	if abilitiesNode then
		abilityNode = GumshoeManager.getGeneralAbilityNode(abilitiesNode, getStringValue());
		message = Interface.getString("AbilityNotFound") .. getStringValue();
	else
		message = Interface.getString("AbilitiesNotInitialized") ..  ' (' .. getStringValue() .. ')';
	end

	if not abilityNode then
		unlink();
		if bNotify then
			ChatManager.Message(message, true, DB.getChild(nodeWin, '...'));
			setValue("");
		end
		return;
	end

	window.rating.setLink(DB.createChild(abilityNode, "rating", "number"), true);
	window.pool.setLink(DB.createChild(abilityNode, "pool", "number"), true);
	window.setAbilityNode(abilityNode);
end

function unlink()
	window.rating.setLink(nil, true);
	window.pool.setLink(nil, true);
	window.rating.setValue(0);
	window.pool.setValue(0);
	window.rating.setReadOnly(true);
	window.pool.setReadOnly(true);
	window.setAbilityNode(nil);
end
</LUACode>
