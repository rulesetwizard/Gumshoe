    <LUACode>
function onBeforeDiceRoll(dragInfo)
	local nodeStability = window.getStabilityNode();
	if not nodeStability then
		return false;
	end
	-- A pending Stability test keeps the state before this spend, which may change it
	GumshoeManager.prepareStabilityTest(window.getDatabaseNode());
	return GumshoeManager.UseGeneralAbility(nodeStability, getValue());
end

function onAfterDiceRoll()
	setValue(0);
end

</LUACode>
