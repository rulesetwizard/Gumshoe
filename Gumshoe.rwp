    <LUACode>
function onButtonPress()
	Interface.dialogMessage(onDialogEnd, Interface.getString("ResetPoolsConfirm"), Interface.getString("ResetPoolsTitle"), "yesno");
end

function onDialogEnd(result)
	if result == "yes" then
		GumshoeData.ResetAbilityPools();
	end
end
