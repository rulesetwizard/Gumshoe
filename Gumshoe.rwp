    <LUACode>
local HealthNode = nil;
local StabilityNode = nil;
local SanityNode = nil;

function onInit()
	linkHealthStability();
	updateSanityVisibility();

	-- Relink when the roles, names or list of the general abilities change
	local sAbilities = DB.getPath(getDatabaseNode(), "abilities.generalsections");
	DB.addHandler(sAbilities .. ".*.role", "onAdd", onAbilitiesChanged);
	DB.addHandler(sAbilities .. ".*.role", "onUpdate", onAbilitiesChanged);
	DB.addHandler(sAbilities .. ".*.name", "onUpdate", onAbilitiesChanged);
	DB.addHandler(sAbilities, "onChildDeleted", onAbilitiesChanged);

	-- Sanity can never be higher than 10 minus Cthulhu Mythos
	DB.addHandler(sAbilities .. ".*.rating", "onUpdate", onSanityLimitChanged);
	DB.addHandler(getMythosRatingsPath(), "onUpdate", onSanityLimitChanged);

	-- Show the Stability test an NPC asks for, until it is rolled
	local sPending = DB.getPath(getDatabaseNode(), "pendingstability");
	DB.addHandler(sPending, "onAdd", onPendingStabilityChanged);
	DB.addHandler(sPending, "onChildUpdate", onPendingStabilityChanged);
	DB.addHandler(sPending, "onDelete", onPendingStabilityChanged);

	OptionsManager.registerCallback("SANITY", updateSanityVisibility);
end

function onClose()
	local sAbilities = DB.getPath(getDatabaseNode(), "abilities.generalsections");
	DB.removeHandler(sAbilities .. ".*.role", "onAdd", onAbilitiesChanged);
	DB.removeHandler(sAbilities .. ".*.role", "onUpdate", onAbilitiesChanged);
	DB.removeHandler(sAbilities .. ".*.name", "onUpdate", onAbilitiesChanged);
	DB.removeHandler(sAbilities, "onChildDeleted", onAbilitiesChanged);

	DB.removeHandler(sAbilities .. ".*.rating", "onUpdate", onSanityLimitChanged);
	DB.removeHandler(getMythosRatingsPath(), "onUpdate", onSanityLimitChanged);

	local sPending = DB.getPath(getDatabaseNode(), "pendingstability");
	DB.removeHandler(sPending, "onAdd", onPendingStabilityChanged);
	DB.removeHandler(sPending, "onChildUpdate", onPendingStabilityChanged);
	DB.removeHandler(sPending, "onDelete", onPendingStabilityChanged);

	OptionsManager.unregisterCallback("SANITY", updateSanityVisibility);
end

-- Ratings of the investigative abilities, among them Cthulhu Mythos
function getMythosRatingsPath()
	return DB.getPath(getDatabaseNode(), "abilities.investigativesections.*.abilities.*.rating");
end

function onAbilitiesChanged()
	linkHealthStability();
end

function onSanityLimitChanged()
	GumshoeManager.applySanityLimit(getDatabaseNode());
end

function onPendingStabilityChanged()
	updateStates();
end

--	--Initialize investigative abilities list if it's empty
--    local ListNode = DB.createChild(getDatabaseNode(), '.abilities.investigativesections');
--    if ListNode.getChildCount() == 0 then
--		-- Create sections
--        for section, abilities in pairs(GumshoeData.getInvestigativeAbilities()) do
--            local nodeSection = DB.createChild(ListNode);
--            DB.createChild(nodeSection, "sectionName", "string");
--			DB.setValue(nodeSection, "sectionName", "string", section);
--			
--            local nodeAbilities = DB.createChild(nodeSection, "abilities");
--			-- Create abilities for each section
--			for _, ability in pairs(abilities) do
--				local nodeAbility = DB.createChild(nodeAbilities);
--				DB.setValue(nodeAbility, "name", "string", ability);
--			end
--        end
--        -- Set edit mode on
--        --parentcontrol.window.abilities.subwindow.btnEditLists.setValue(1);
--    end
--
--	--Initialize general abilities list if it's empty
--    ListNode = DB.createChild(getDatabaseNode(), '.abilities.generalsections');
--    if ListNode.getChildCount() == 0 then
--		-- Create abilities for each section
--		for _, ability in pairs(GumshoeData.getGeneralAbilities()) do
--			local nodeAbility = DB.createChild(ListNode);
--			DB.setValue(nodeAbility, "name", "string", ability);
--		end
--        -- Set edit mode on
--        --parentcontrol.window.abilities.subwindow.btnEditLists.setValue(1);
--    end

function linkHealthStability()
	-- Initialize Health, Stability and Sanity field links
	HealthNode = GumshoeManager.getAbilityByRole(getDatabaseNode(), "health");
	StabilityNode = GumshoeManager.getAbilityByRole(getDatabaseNode(), "stability");
	SanityNode = GumshoeManager.getAbilityByRole(getDatabaseNode(), "sanity");
	linkAbilityFields(HealthNode, healthName, healthRating, healthPool);
	linkAbilityFields(StabilityNode, stabilityName, stabilityRating, stabilityPool);
	linkAbilityFields(SanityNode, sanityName, sanityRating, sanityPool);
	updateStates();
end

-- Links the fields to the ability, or leaves them empty if the character does not have it
function linkAbilityFields(nodeAbility, ctrlName, ctrlRating, ctrlPool)
	if nodeAbility then
		ctrlName.setValue(DB.getValue(nodeAbility, "name", ""));
		ctrlRating.setLink(DB.createChild(nodeAbility, "rating", "number"), true);
		ctrlPool.setLink(DB.createChild(nodeAbility, "pool", "number"), true);
	else
		ctrlRating.setLink(nil);
		ctrlPool.setLink(nil);
		ctrlRating.setValue(0);
		ctrlPool.setValue(0);
		ctrlRating.setReadOnly(true);
		ctrlPool.setReadOnly(true);
	end
end

-- The Sanity row is shown with the Sanity option (Trail of Cthulhu)
function updateSanityVisibility()
	local bSanity = GumshoeData.isSanityEnabled();
	sanityName.setVisible(bSanity);
	sanityRating.setVisible(bSanity);
	sanityPool.setVisible(bSanity);
	sanityState.setVisible(bSanity);
end

-- Health, Stability and Sanity states under their names, and the pending Stability test. The pool fields call it
-- while the window is being built, before the state labels exist
function updateStates()
	if not healthState or not stabilityState or not stabilityPending or not sanityState then
		return;
	end
	local sHealthState = "";
	if HealthNode then
		sHealthState = GumshoeManager.getStateText(GumshoeManager.getHealthState(DB.getValue(HealthNode, "pool", 0), false));
	end
	healthState.setValue(sHealthState);
	local sStabilityState = "";
	if StabilityNode then
		sStabilityState = GumshoeManager.getStateText(GumshoeManager.getStabilityState(DB.getValue(StabilityNode, "pool", 0)));
	end
	stabilityState.setValue(sStabilityState);
	local sSanityState = "";
	if SanityNode then
		sSanityState = GumshoeManager.getStateText(GumshoeManager.getSanityState(DB.getValue(SanityNode, "pool", 0)));
	end
	sanityState.setValue(sSanityState);
	stabilityPending.setValue(GumshoeManager.getPendingStabilityText(getDatabaseNode()));
end

-- Consciousness roll, when Health is below 0. The Health test value is the Health spent to add to the die, and the
-- difficulty is the pool before spending it
function rollConsciousness()
	if not HealthNode then
		return;
	end
	local nPool = DB.getValue(HealthNode, "pool", 0);
	if nPool &gt;= 0 or GumshoeManager.getHealthState(nPool, false) == "dead" then
		return;
	end
	local nSpend = healthTest.getValue();
	if nSpend &gt; 0 then
		if not GumshoeManager.UseGeneralAbility(HealthNode, nSpend) then
			return;
		end
		healthTest.setValue(0);
	end
	GumshoeManager.rollConsciousness(getDatabaseNode(), math.abs(nPool), nSpend);
end

function getHealthNode()
	return HealthNode;
end

function getStabilityNode()
	return StabilityNode;
end

function getSanityNode()
	return SanityNode;
end

