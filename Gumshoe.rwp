<Ruleset xmlns="http://tempuri.org/Ruleset.xsd">
  <RulesetProperties>
    <Name>Gumshoe</Name>
    <CompilationType>Ruleset</CompilationType>
    <Description>Generic ruleset for Gumshoe system</Description>
    <DisplayName />
    <DisplayVersion />
    <Author>Psicodelix</Author>
    <Website>www.rulesetwizard.com</Website>
    <Version>1</Version>
    <Release>0</Release>
    <RulesetWizardVersion>0.10.1</RulesetWizardVersion>
    <RulesetList>CoreRPG</RulesetList>
    <LoadOrder />
    <Comments />
    <Announcement>Generic ruleset for Gumshoe system. Based on the Gumshoe SRD rules:
https://gumshoe-srd.com/</Announcement>
    <LogoFile />
    <ImportRuleset>CoreRPG</ImportRuleset>
    <AdvancedDevelopment>true</AdvancedDevelopment>
    <GeneratePath />
    <UseAutoPath>true</UseAutoPath>
    <AnnouncementFont />
    <AnnouncementIcon />
    <Announcement2>You can download the source code of the project from the github repository:
https://github.com/rulesetwizard/Gumshoe/</Announcement2>
    <Announcement2Font />
    <Announcement2Icon />
    <Announcement3 />
    <Announcement3Font />
    <Announcement3Icon />
    <ExcludeRSWScripts>false</ExcludeRSWScripts>
    <CompileToFolder>false</CompileToFolder>
    <DefaultEncoding>iso-8859-1</DefaultEncoding>
  </RulesetProperties>
</Ruleset>

