    <LUACode>
function onBeforeDiceRoll(dragInfo)
	local abilityNode = window.getAbilityNode();
	if abilityNode then
		return GumshoeManager.UseGeneralAbility(abilityNode, getValue());
	else
		return false;
	end;
end

function onAfterDiceRoll()
	setValue(0);
end
</LUACode>
