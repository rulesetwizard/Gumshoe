    <LUACode>
-- Radial menu with the Mythos revelations (Trail of Cthulhu), each with its Stability and Sanity loss
local MenuRevelations = 3;
local RevelationPositions = { 1, 2, 4, 5, 6 };

function onInit()
	if super and super.onInit then
		super.onInit();
	end
	registerMenuItem(Interface.getString("MythosRevelationMenu"), "radial_magicwand", MenuRevelations);
	for nLevel = 1, GumshoeManager.getMythosRevelationCount() do
		registerMenuItem(Interface.getString("MythosRevelation" .. nLevel), "radial_magicwand", MenuRevelations, RevelationPositions[nLevel]);
	end
end

function onMenuSelection(selection, subselection)
	if selection ~= MenuRevelations then
		return;
	end
	for nLevel, nPosition in ipairs(RevelationPositions) do
		if subselection == nPosition then
			GumshoeManager.applyMythosRevelation(window.getDatabaseNode(), nLevel);
		end
	end
end

function onDoubleClick(x, y)
	local nodeSanity = window.getSanityNode();
	if nodeSanity then
		GumshoeManager.UseAbilityPool(nodeSanity, window.getDatabaseNode(), Input.isAltPressed());
	end
end

-- Called by number_crosslink when the linked pool changes
function update()
	window.updateStates();
end
</LUACode>
