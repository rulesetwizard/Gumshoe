    <LUACode>-- Path of the general abilities of the linked PC, whose changes relink its Health
local sPCAbilitiesPath = nil;

function onInit()
	-- Set the displays to what should be shown
	setTargetingVisible();
	setSpacingVisible();
	setEffectsVisible();
	setAttacksVisible();
	setDefenseVisible();
	
	if self.isPC() then
		activateattacks.setVisible(false);
	end
	
	-- Acquire token reference, if any
	self.linkToken();
	
	-- Set up the PC links
	self.onLinkChanged();
	self.onFactionChanged();
	self.updateHealthState();
	
	-- Register the deletion menu item for the host
	registerMenuItem(Interface.getString("list_menu_deleteitem"), "delete", 6);
	registerMenuItem(Interface.getString("list_menu_deleteconfirm"), "delete", 6, 7);
end

function onClose()
	removePCAbilityHandlers();
end

function onMenuSelection(selection, subselection)
	if selection == 6 and subselection == 7 then
		self.delete();
	end
end
function onLinkChanged()
	-- If a PC, then set up the links to the char sheet
	if self.isPC() then
		self.linkPCFields();
		name.setLine(false);
	end
	self.onIDChanged();
end
function onIDChanged()
	local nodeRecord = getDatabaseNode();
	local sClass = link.getValue();
	local sRecordType = LibraryData.getRecordTypeFromDisplayClass(sClass);
	local bID = LibraryData.getIDState(sRecordType, nodeRecord, true);
	
	name.setVisible(bID);
	nonid_name.setVisible(not bID);

	isidentified.setVisible(LibraryData.getIDMode(sRecordType));
end
function onFactionChanged()
	-- Update the entry frame
	self.updateDisplay();

	-- If not a friend, then show visibility toggle
	if friendfoe.getStringValue() == "friend" then
		tokenvis.setVisible(false);
	else
		tokenvis.setVisible(true);
	end
end
function onVisibilityChanged()
	TokenManager.updateVisibility(getDatabaseNode());
	windowlist.onVisibilityToggle();
end

function updateDisplay()
	local sFaction = friendfoe.getStringValue();

	if DB.getValue(getDatabaseNode(), "active", 0) == 1 then
		name.setFont("sheetlabel");
		nonid_name.setFont("sheetlabel");
		
		if sFaction == "friend" then
			setFrame("ctentrybox_friend_active");
		elseif sFaction == "neutral" then
			setFrame("ctentrybox_neutral_active");
		elseif sFaction == "foe" then
			setFrame("ctentrybox_foe_active");
		else
			setFrame("ctentrybox_active");
		end
	else
		name.setFont("sheettext");
		nonid_name.setFont("sheettext");
		
		if sFaction == "friend" then
			setFrame("ctentrybox_friend");
		elseif sFaction == "neutral" then
			setFrame("ctentrybox_neutral");
		elseif sFaction == "foe" then
			setFrame("ctentrybox_foe");
		else
			setFrame("ctentrybox");
		end
	end
end

function linkToken()
	local imageinstance = token.populateFromImageNode(tokenrefnode.getValue(), tokenrefid.getValue());
	if imageinstance then
		TokenManager.linkToken(getDatabaseNode(), imageinstance);
	end
end

function delete()
	local node = getDatabaseNode();
	if not node then
		close();
		return;
	end
	
	-- Clear any effects first, so that saves aren't triggered when initiative advanced
	DB.deleteChildren(node, "effects");

	-- Clear NPC wounds, so that ruleset turn end dying checks aren't triggered when initiative advanced
	if wounds and not self.isPC() then
		DB.setValue(node, "wounds", "number", 0);
	end

	-- Move to the next actor, if this CT entry is active
	if self.isActive() then
		CombatManager.nextActor();
	end

	-- Delete the database node and close the window
	local cList = windowlist;
	node.delete();

	-- Update list information (global subsection toggles)
	cList.onVisibilityToggle();
end

function linkPCFields()
	local nodeChar = link.getTargetDatabaseNode();
	if nodeChar then
		name.setLink(nodeChar.createChild("name", "string"), true);
		initresult.setLink(nodeChar.createChild("initresult", "number"), false);
		-- initability is a string; earlier versions created it as a number, which can never hold the ability name
		local nodeInitAbility = DB.getChild(nodeChar, "initability");
		if nodeInitAbility and DB.getType(nodeInitAbility) == "number" then
			DB.deleteNode(nodeInitAbility);
		end
		initability.setLink(DB.createChild(nodeChar, "initability", "string"), false);
		sub_defense.subwindow.hitthreshold.setLink(nodeChar.createChild("hitthreshold", "number"), true);
		sub_defense.subwindow.armor.setLink(nodeChar.createChild("armor", "number"), true);
		linkPCHealth();

		-- Relink the Health when the roles or list of the PC's general abilities change, and update the states
		-- when its pools change (the Stability pool is not shown in the combat tracker)
		removePCAbilityHandlers();
		sPCAbilitiesPath = DB.getPath(nodeChar, "abilities.generalsections");
		DB.addHandler(sPCAbilitiesPath .. ".*.role", "onAdd", linkPCHealth);
		DB.addHandler(sPCAbilitiesPath .. ".*.role", "onUpdate", linkPCHealth);
		DB.addHandler(sPCAbilitiesPath, "onChildDeleted", linkPCHealth);
		DB.addHandler(sPCAbilitiesPath .. ".*.pool", "onUpdate", updateHealthState);
	end
end

function linkPCHealth()
	local nodeChar = link.getTargetDatabaseNode();
	local nodeHealth = nil;
	if nodeChar then
		nodeHealth = GumshoeManager.getAbilityByRole(nodeChar, "health");
	end
	if nodeHealth then
		healthPool.setLink(DB.createChild(nodeHealth, "pool", "number"), false);
	else
		healthPool.setLink(nil);
	end
	updateHealthState();
end

function removePCAbilityHandlers()
	if sPCAbilitiesPath then
		DB.removeHandler(sPCAbilitiesPath .. ".*.role", "onAdd", linkPCHealth);
		DB.removeHandler(sPCAbilitiesPath .. ".*.role", "onUpdate", linkPCHealth);
		DB.removeHandler(sPCAbilitiesPath, "onChildDeleted", linkPCHealth);
		DB.removeHandler(sPCAbilitiesPath .. ".*.pool", "onUpdate", updateHealthState);
		sPCAbilitiesPath = nil;
	end
end

-- Health state, and Stability state for PCs, under the name. The Health field calls it while the window is being
-- built, before the state label exists
function updateHealthState()
	if not healthState then
		return;
	end
	healthState.setValue(GumshoeManager.getActorStatesText(ActorManager.resolveActor(getDatabaseNode())));
end

-- Consciousness roll, when Health is below 0, without spending Health (a PC spends it from the character sheet)
function rollConsciousness()
	local rActor = ActorManager.resolveActor(getDatabaseNode());
	local nPool = GumshoeManager.getActorHealth(rActor);
	if not nPool or nPool &gt;= 0 or GumshoeManager.getHealthState(nPool, GumshoeManager.isPulpNPC(rActor)) == "dead" then
		return;
	end
	GumshoeManager.rollConsciousness(ActorManager.getCreatureNode(rActor), math.abs(nPool), 0);
end

--
--	HELPERS
--

function isRecordType(s)
	local sClass = link.getValue();
	local sRecordType = LibraryData.getRecordTypeFromDisplayClass(sClass);
	return (sRecordType == s);
end
function isPC()
	return self.isRecordType("charsheet");
end
function isActive()
	return (active.getValue() == 1);
end


--
-- SECTION VISIBILITY FUNCTIONS
--

function setTargetingVisible()
	local v = false;
	if activatetargeting.getValue() == 1 then
		v = true;
	end
	targetingicon.setVisible(v);
	sub_targeting.setVisible(v);
	target_summary.onTargetsChanged();
end

function setSpacingVisible()
	local v = false;
	if activatespacing.getValue() == 1 then
		v = true;
	end
	spacingicon.setVisible(v);
	sub_spacing.setVisible(v);
end

function setEffectsVisible()
	local v = false;
	if activateeffects.getValue() == 1 then
		v = true;
	end
	
	effecticon.setVisible(v);
	sub_effects.setVisible(v);
	if sub_effects.subwindow then
        sub_effects.subwindow.setEffectsVisible(v);
	end
	effect_summary.onEffectsChanged();
end

function setAttacksVisible()
	local v = false;
	if activateattacks.getValue() == 1 then
		v = true;
	end
	attacksicon.setVisible(v);
	sub_attacks.setVisible(v);
end

function setDefenseVisible()
	local v = false;
	if activatedefense.getValue() == 1 then
		v = true;
	end
	defenseicon.setVisible(v);
	sub_defense.setVisible(v);
end
