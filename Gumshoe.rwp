    <LUACode>
function onInit()
	--Initialize abilities list if it's empty
    local ListNode = listAbilities.getDatabaseNode();
    if ListNode.getChildCount() == 0 then
		-- Create abilities for each section
		for _, ability in ipairs(GumshoeData.getGeneralAbilities()) do
			local wAbility = listAbilities.createWindow();
			local nodeAbility = wAbility.getDatabaseNode();
			DB.setValue(nodeAbility, "name", "string", ability.name);
			DB.setValue(nodeAbility, "role", "string", ability.role or "");
		end
		-- Trail of Cthulhu: Sanity, whose first 4 points are free
		if GumshoeData.isSanityEnabled() then
			local rSanity = GumshoeData.getSanityAbility();
			local nodeSanity = listAbilities.createWindow().getDatabaseNode();
			DB.setValue(nodeSanity, "name", "string", rSanity.name);
			DB.setValue(nodeSanity, "role", "string", rSanity.role);
			DB.setValue(nodeSanity, "rating", "number", rSanity.rating);
			DB.setValue(nodeSanity, "pool", "number", rSanity.rating);
			DB.setValue(nodeSanity, "buildPointsType", "string", "firstfree");
			DB.setValue(nodeSanity, "customBuildPoints", "number", rSanity.rating);
		end
        -- Set edit mode on
        parentcontrol.window.btnEditLists.setValue(1);
    end
    
    -- Characters created before ability roles existed get them from the ability names
    GumshoeManager.migrateAbilityRoles(ListNode);

    -- Set field links of main tab Health and Stability
    parentcontrol.window.parentcontrol.window.main.subwindow.linkHealthStability();
end

function setEdit(bEdit)
	listAbilities_iadd.setVisible(bEdit);
	listAbilities_iedit.setVisible(bEdit);
	if not bEdit then
		listAbilities_iedit.setValue(0);
		spacerHeader.setVisible(bEdit);
	end
	for _,w in ipairs(listAbilities.getWindows()) do
		w.setEdit(bEdit);
	end
end

function CalculateBuildPoints()
	local total = 0;
	for _,w in ipairs(listAbilities.getWindows()) do
		total = total + GumshoeManager.getBuildPointsCost(w);
	end

	totalBuildPointsGeneral.setValue(total);
end

function onFirstLayout()
	CalculateBuildPoints();
end
</LUACode>
