    <LUACode>
function onInit()
	setEdit();
end

function onValueChanged()
	setEdit();
end

function setEdit()
	if getValue() &gt; 0 then
		window.subInvestigative.subwindow.setEdit(true);
		window.subGeneral.subwindow.setEdit(true);
	else
		window.subInvestigative.subwindow.setEdit(false);
		window.subGeneral.subwindow.setEdit(false);
	end;
end</LUACode>
