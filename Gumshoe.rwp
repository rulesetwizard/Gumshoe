    <LUACode>
function onInit()
	super.onInit();
	local values = '';
	for _, ability in pairs(GumshoeData.getCombatAbilities()) do
		if values == '' then
			values = ability;
		else
			values = values .. '|' .. ability;
		end
	end
	-- No initial value: initialize would replace the stored one
	initialize(values, values, '', nil);
end
</LUACode>
