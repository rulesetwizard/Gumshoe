    <LUACode>function onButtonPress()
	local ctnode = window.windowlist.window.getDatabaseNode();
	DB.setValue(ctnode, "initresult", "number", window.rating.getValue());
	DB.setValue(ctnode, "initability", "string", window.name.getValue());	
end
