    <LUACode>
-- Not bound to a field of its own: it shows and sets the role of the ability ("combat" or none), like the PC abilities
local bRefreshing = false;

function onInit()
	refresh();
end

-- Shows the role without writing it
function refresh()
	bRefreshing = true;
	if GumshoeManager.getAbilityRole(window.getDatabaseNode()) == "combat" then
		setValue(1);
	else
		setValue(0);
	end
	bRefreshing = false;
end

function onValueChanged()
	if bRefreshing then
		return;
	end
	if getValue() == 1 then
		DB.setValue(window.getDatabaseNode(), "role", "string", "combat");
	else
		DB.setValue(window.getDatabaseNode(), "role", "string", "");
	end
	window.name.setAttackVisibility();
end
</LUACode>
