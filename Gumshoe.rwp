    <LUACode>function onDrop(x, y, draginfo)
	return handleDrop(draginfo, nil);
end

function handleDrop(draginfo, nodeTargetList)
	if draginfo.isType("shortcut") then
		local sClass, sRecord = draginfo.getShortcutData();
		if sClass == "ability" then
			local nodeSource = GumshoeData.resolveRefNode(sRecord);
			if not nodeSource then
				return;
			end
	
			local nodeList = getDatabaseNode();
			local nodeEntry = nodeList.createChild();
			local sClass, sRecord = draginfo.getShortcutData();
			DB.setValue(nodeEntry, "name", "string", DB.getValue(nodeSource, "name"));
			-- NPCs only use the combat role (their Health is a field of its own). Records created before roles existed
			-- have none: the role then comes from the name
			local sRole = DB.getValue(nodeSource, "role");
			if sRole then
				DB.setValue(nodeEntry, "role", "string", (sRole == "combat") and "combat" or "");
			end
			return true;
		end
	end
end

local sFocus = "name"; 

function onListChanged()
	update();
end

function update()
	local sEdit = getName() .. "_iedit";
	if window[sEdit] then
		local bEdit = (window[sEdit].getValue() == 1);
		for _,w in ipairs(getWindows()) do
			w.idelete.setVisible(bEdit);
		end
	end
end

function addEntry(bFocus)
	local w = createWindow();
	if bFocus then
		w[sFocus].setFocus();
	end
	return w;
end</LUACode>
