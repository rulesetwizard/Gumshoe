    <LUACode>function onInit()
	setAttackVisibility();
end

function onValueChanged()
	setAttackVisibility();	
end

function setAttackVisibility()
	local bCombat = (GumshoeManager.getAbilityRole(window.getDatabaseNode()) == "combat");
	window.test.setVisible(not bCombat);
	window.testattack.setVisible(bCombat);
	window.btnInit.setVisible(bCombat);
	window.btnCombat.refresh();
end
</LUACode>
