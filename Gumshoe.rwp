    <LUACode>
function onBeforeDiceRoll(dragInfo)
	local nodeHealth = window.getHealthNode();
	if not nodeHealth then
		return false;
	end
	return GumshoeManager.UseGeneralAbility(nodeHealth, getValue());
end

function onAfterDiceRoll()
	setValue(0);
end

</LUACode>
