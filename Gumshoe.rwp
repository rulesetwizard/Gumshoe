    <LUACode>
function onDoubleClick(x, y)
	local nodeHealth = window.getHealthNode();
	if nodeHealth then
		GumshoeManager.UseAbilityPool(nodeHealth, window.getDatabaseNode(), Input.isAltPressed());
	end
end

-- Called by number_crosslink when the linked pool changes
function update()
	window.updateStates();
end
