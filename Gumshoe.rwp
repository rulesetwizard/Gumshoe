    <LUACode>
function onDoubleClick(x, y)
	local abilityNode = window.getAbilityNode();
	if abilityNode then
		local nodeWin = window.getDatabaseNode();
		GumshoeManager.UseAbilityPool(abilityNode, nodeWin.getChild('...'), Input.isAltPressed());
	end;
end

function onWheel(notches)
	return false;
end
</LUACode>
