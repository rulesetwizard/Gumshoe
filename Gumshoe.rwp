    <LUACode>
local abilityNode = nil;

function setEdit(bEdit)
	name.setReadOnly(not bEdit);
	name.setLine(bEdit);
	rating.setReadOnly(not bEdit);	
end

function getAbilityNode()
	return abilityNode;
end

function setAbilityNode(node)
	abilityNode = node;
end</LUACode>
