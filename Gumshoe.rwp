    <LUACode>
function onDoubleClick(x, y)
	local nodeStability = window.getStabilityNode();
	if nodeStability then
		GumshoeManager.UseAbilityPool(nodeStability, window.getDatabaseNode(), Input.isAltPressed());
	end
end

-- Called by number_crosslink when the linked pool changes
function update()
	window.updateStates();
end
</LUACode>
