    <LUACode>
function onInit()
	update();
end

function onLockChanged()
	update();
end
			
function update()

	local bReadOnly = WindowManager.getReadOnlyState(getDatabaseNode());
	name.setReadOnly(bReadOnly);
	type.setReadOnly(bReadOnly);
	role.setReadOnly(bReadOnly);
	description.setReadOnly(bReadOnly);
	updateRole();

end

-- Only general abilities have a role. The type list calls this while the window is being built, before the role
-- controls exist
function updateRole()
	if not role then
		return;
	end
	local bGeneral = (DB.getValue(getDatabaseNode(), "type", "") == "general");
	lblRole.setVisible(bGeneral);
	role.setVisible(bGeneral);
end</LUACode>
